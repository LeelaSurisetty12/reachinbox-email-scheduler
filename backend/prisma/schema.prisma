generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  emails    Email[]
  slack     SlackConnection?
}

model Sender {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([userId, email])
}

model Email {
  id          String      @id @default(uuid())
  userId      String
  senderId    String

  recipient   String
  subject     String
  body        String

  scheduledAt DateTime
  sentAt      DateTime?

  delayMs     Int         @default(2000)
  hourlyLimit Int         @default(100)

  status      EmailStatus @default(SCHEDULED)

  attempts    Int         @default(0)
  bullJobId   String?     @unique
  messageId   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender      Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([senderId, scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String?
  webhookUrl   String
  channelId    String?
  channelName  String?
  teamId       String?
  teamName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}